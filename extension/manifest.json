{
  "manifest_version": 3,
  "name": "Auto Mở Live",
  "version": "1.1.6",
  "description": "Theo dõi các kênh YouTube bạn chọn, thông báo và tự mở tab khi có video mới hoặc livestream bắt đầu.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://oauth2.googleapis.com https://www.googleapis.com https://www.youtube.com;"
  },
  "key": "",
  "homepage_url": "https://youtube-notification.chuan-nv.com/"
}
