{
  "manifest_version": 3,
  "name": "YouTube Kênh Yêu Thích - Tự Mở Video Mới",
  "version": "1.1.0",
  "description": "Theo dõi kênh YouTube: tự mở tab ngay khi có video mới hoặc khi livestream bắt đầu phát.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://www.googleapis.com https://www.youtube.com;"
  },
  "key": ""
}
